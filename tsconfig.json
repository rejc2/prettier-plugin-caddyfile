{
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"noEmit": true,
		"target": "ESNext",
		"useDefineForClassFields": true,
		"lib": ["ESNext", "WebWorker"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",

		/* Linting */
		"strict": true,
		"noFallthroughCasesInSwitch": true,

		/* Path mapping */
		"paths": {
			"@/*": ["./src/*"]
		},

		"types": ["node"]
	},
	"include": ["src", "eslint.config.ts"],
	"exclude": ["node_modules", "dist"]
}
